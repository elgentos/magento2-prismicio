{
    "name": "elgentos/module-prismicio",
    "description": "Magento 2 - Prismic.io integration",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "authors": [
        {
            "name": "Jeroen Boersma",
            "email": "jeroen@elgentos.nl"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "elgentos/prismic-php-sdk": "^6.1",
        "magento/module-cms-url-rewrite": "*",
        "magento/framework": "*"
    },
    "replace": {
        "elgentos/prismic-io": "*"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "autoload": {
        "psr-4": { "Elgentos\\PrismicIO\\": "src/" },
        "files": [ "src/registration.php" ]
    },
    "autoload-dev": {
        "psr-4": { "Elgentos\\PrismicIO\\": "tests/" }
    },
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    }
}
